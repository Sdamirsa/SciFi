{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "SciFi envelope",
 "type": "object",
 "required": [
  "task_id",
  "agent_id",
  "status",
  "result",
  "evidence"
 ],
 "properties": {
  "task_id": {
   "type": "string"
  },
  "agent_id": {
   "type": "string"
  },
  "model": {
   "type": "string"
  },
  "status": {
   "type": "string",
   "enum": [
    "done",
    "partial",
    "blocked"
   ]
  },
  "result": {
   "type": "string",
   "description": "one paragraph: what was found, in prose a human can read without opening files"
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "what the agent read or ran, so the master can spot-check"
  },
  "findings": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "severity",
     "issue",
     "solution",
     "location"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "axis": {
      "type": "string",
      "enum": [
       "flow",
       "local",
       "global",
       "evidence",
       "style",
       "logic",
       "figure",
       "gate",
       "other"
      ]
     },
     "severity": {
      "type": "string",
      "enum": [
       "blocker",
       "major",
       "minor",
       "nit"
      ]
     },
     "issue": {
      "type": "string"
     },
     "solution": {
      "type": "string"
     },
     "location": {
      "type": "string",
      "description": "unit id plus sentence number or a short quote, e.g. p04:s3"
     },
     "quote": {
      "type": "string",
      "description": "at most 12 words of the offending text"
     },
     "rule": {
      "type": "string",
      "description": "standards reference, e.g. checklist C2 or results.md paragraph template"
     },
     "response": {
      "type": "string",
      "enum": [
       "accept",
       "reject",
       "defer",
       "pending"
      ]
     },
     "response_note": {
      "type": "string"
     }
    }
   }
  },
  "artifacts": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "needs": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "NEED: requests, one per missing input or source"
  },
  "deviations": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "uncertainties": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "questions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "suggestions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "verdict": {
   "type": "string",
   "enum": [
    "PASS",
    "RETURN"
   ],
   "description": "gate agents only"
  },
  "returned_at": {
   "type": "string"
  },
  "manuscript_verdict": {
   "type": "string",
   "enum": [
    "accept",
    "minor",
    "major",
    "reject"
   ],
   "description": "standards-gate at manuscript scope only"
  }
 }
}