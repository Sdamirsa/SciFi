{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "SciFi spine",
 "type": "object",
 "required": [
  "central_claim",
  "gap",
  "results",
  "threads",
  "status"
 ],
 "properties": {
  "central_claim": {
   "type": "string",
   "description": "one sentence"
  },
  "alternatives": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "text",
     "why_not"
    ],
    "properties": {
     "text": {
      "type": "string"
     },
     "why_not": {
      "type": "string"
     }
    }
   }
  },
  "gap": {
   "type": "string",
   "description": "the unknown the introduction promises to fill, one sentence"
  },
  "aim": {
   "type": "string"
  },
  "design": {
   "type": "string"
  },
  "results": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "statement"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^R[0-9]+$"
     },
     "statement": {
      "type": "string",
      "description": "one finding as a sentence with its number and uncertainty"
     },
     "display": {
      "type": "string",
      "description": "figure or table that shows it"
     },
     "source": {
      "type": "string",
      "description": "where in results.md"
     }
    }
   }
  },
  "implications": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "statement"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^I[0-9]+$"
     },
     "statement": {
      "type": "string"
     },
     "strength": {
      "type": "string",
      "enum": [
       "strong",
       "moderate",
       "hedged"
      ]
     }
    }
   }
  },
  "threads": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "opens",
     "results",
     "closes"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^T[0-9]+$"
     },
     "name": {
      "type": "string"
     },
     "opens": {
      "type": "string",
      "description": "the introduction sentence or question that opens this thread"
     },
     "results": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "result ids that carry it"
     },
     "closes": {
      "type": "string",
      "description": "the discussion implication that closes it"
     },
     "limitation": {
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "open",
       "carried",
       "closed",
       "orphan"
      ]
     }
    }
   }
  },
  "status": {
   "type": "string",
   "enum": [
    "draft",
    "agreed"
   ]
  },
  "decided_by": {
   "type": "string"
  },
  "updated_at": {
   "type": "string"
  }
 }
}