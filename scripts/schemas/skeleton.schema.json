{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "SciFi skeleton",
 "type": "object",
 "required": [
  "journal",
  "sections",
  "status"
 ],
 "properties": {
  "journal": {
   "type": "string"
  },
  "word_budget": {
   "type": "object"
  },
  "sections": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "section",
     "units"
    ],
    "properties": {
     "section": {
      "type": "string"
     },
     "target_words": {
      "type": "integer"
     },
     "units": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "takeaway",
        "does",
        "thread"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z]+[0-9]{2}$",
         "description": "i01, m03, r02, d05, a01, t01, c01 for captions"
        },
        "takeaway": {
         "type": "string"
        },
        "does": {
         "type": "string",
         "description": "what this paragraph does, one clause"
        },
        "thread": {
         "type": "string"
        },
        "keep_here": {
         "type": "string"
        },
        "defer": {
         "type": "string"
        },
        "display": {
         "type": "string"
        },
        "status": {
         "type": "string",
         "enum": [
          "planned",
          "mapped",
          "drafted",
          "reviewed",
          "accepted",
          "human-edited",
          "blocked"
         ]
        },
        "target_words": {
         "type": "integer"
        }
       }
      }
     }
    }
   }
  },
  "status": {
   "type": "string",
   "enum": [
    "draft",
    "agreed"
   ]
  },
  "updated_at": {
   "type": "string"
  }
 }
}